<view wx:if="{{loading}}" class="loading" style="padding:120rpx 0;text-align:center;color:#94a3b8;">
  <view style="font-size:60rpx;">📦</view><view style="margin-top:16rpx;">加载中...</view>
</view>
<view wx:elif="{{!goods}}" class="empty"><text class="empty-emoji">❓</text><view class="empty-txt">商品不存在或已下架</view></view>
<block wx:else>
  <!-- 商品图 -->
  <view class="goods-big">
    <image wx:if="{{goods.image}}" src="{{goods.image}}" mode="aspectFill"></image>
    <text wx:else style="font-size:200rpx;">{{goods.emoji || '📦'}}</text>
    <view wx:if="{{goods.is_hot==1}}" class="hb">🔥 热销</view>
    <view class="hb-left" bindtap="goBack" style="top:24rpx;left:24rpx;">← 返回</view>
    <view class="hb-right" bindtap="goOrders" style="top:24rpx;right:24rpx;">📋 订单</view>
  </view>

  <view class="container">
    <!-- 价格块 -->
    <view class="price-card">
      <view class="p-left">
        <view class="p-big">
          <text class="price price-xl">¥ {{goods._priceText}}</text>
          <text wx:if="{{goods.origin_price>goods.price}}" class="p-origin">¥ {{goods._originPriceText}}</text>
        </view>
        <view class="p-row" style="margin-top:14rpx;">
          <text wx:if="{{goods.category}}" class="tag tag-purple">📂 {{goods.category}}</text>
          <text class="tag tag-blue">库存 {{goods.stock}} 件</text>
        </view>
      </view>
      <view wx:if="{{user}}" class="balance-card">
        <view style="font-size:22rpx;color:#94a3b8;">我的余额</view>
        <view class="price price-md c-green" style="font-size:32rpx;">¥ {{userBalanceText}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">📦 {{goods.goods_name}}</view>
      <view style="color:#64748b;line-height:1.7;font-size:26rpx;">{{goods.description}}</view>
      <view wx:if="{{goods.content}}" class="hr"></view>
      <view wx:if="{{goods.content}}" style="font-size:26rpx;color:#475569;line-height:1.8;white-space:pre-wrap;">{{goods.content}}</view>
    </view>

    <!-- 数量 -->
    <view class="card">
      <view class="card-title">🛒 购买数量</view>
      <view class="qty-row">
        <view class="qty" bindtap="minusQty">-</view>
        <input class="qty-inp" type="number" value="{{qty}}" bindblur="onQty"/>
        <view class="qty plus" bindtap="plusQty">+</view>
        <view class="qty-total flex1">
          合计：<text class="price price-lg">¥ {{total}}</text>
        </view>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="card">
      <view class="card-title" bindtap="toggleShip" style="cursor:pointer;">
        📍 收货信息
        <text style="margin-left:auto;color:#667eea;font-size:24rpx;">{{showBuy?'收起 ▲':'展开 ▼'}}</text>
      </view>
      <block wx:if="{{showBuy}}">
        <view class="sel-addr-card" bindtap="goSelectAddress" wx:if="{{user}}">
          <block wx:if="{{hasAddr}}">
            <view class="sa-head">
              <view class="sa-name">{{shipName}}</view>
              <view class="sa-phone">{{shipPhone}}</view>
              <view wx:if="{{selectedAddrDefault}}" class="sa-def">默认</view>
            </view>
            <view class="sa-addr">{{regionText}} {{shipDetail}}</view>
            <view class="sa-hint">
              <text style="color:#6366f1;font-weight:600;">✎ 从地址簿选择</text>
              <text class="sa-arrow">›</text>
            </view>
          </block>
          <block wx:else>
            <view class="sa-empty">
              <text class="sa-e-ic">📋</text>
              <view style="flex:1;">
                <view class="sa-e-title">从地址簿快速选择</view>
                <view class="sa-e-desc">支持多个地址，设置默认地址后自动填入</view>
              </view>
              <text class="sa-arrow">›</text>
            </view>
          </block>
        </view>

        <view wx:if="{{hasAddr}}" class="hr"></view>

        <view class="form-row"><view class="label">收货人</view><input class="inp" placeholder="请输入收货人姓名" value="{{shipName}}" data-k="shipName" bindinput="inp"/></view>
        <view class="form-row"><view class="label">手机号</view><input class="inp" type="number" maxlength="11" placeholder="手机号" value="{{shipPhone}}" data-k="shipPhone" bindinput="inp"/></view>
        <view class="form-row">
          <view class="label">所在地区</view>
          <picker mode="region" bindchange="onRegion" value="{{region}}">
            <view class="inp picker-inp {{regionText===''?'ph':''}}">
              {{regionText || '请选择省/市/区'}}
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="form-row"><view class="label">详细地址</view><input class="inp" placeholder="街道、门牌号、小区楼栋等" value="{{shipDetail}}" data-k="shipDetail" bindinput="inp"/></view>
        <view wx:if="{{!user}}" style="padding:14rpx 18rpx;background:#fef3c7;border-radius:10rpx;color:#92400e;font-size:24rpx;margin-top:10rpx;">⚠️ 购买前需要先登录</view>
      </block>
    </view>

    <view style="height:180rpx;"></view>
  </view>

  <!-- 底部吸底购买条 -->
  <view class="safe-bottom buy-bar">
    <view class="b-left">
      <text class="lbl">应付：</text>
      <text class="price price-xl" style="font-size:40rpx;">¥ {{total}}</text>
    </view>
    <button class="btn btn-primary b-btn" bindtap="buyNow" loading="{{paying}}" disabled="{{paying}}">
      {{user ? '💰 立即购买（余额支付）' : '🔐 先登录再购买'}}
    </button>
  </view>
</block>
