.page{ padding:24rpx; min-height:100vh; box-sizing:border-box; }

.form-card{
  background:#fff; border-radius:20rpx;
  box-shadow:0 4rpx 18rpx rgba(100,116,139,0.06);
  overflow:hidden;
}
.form-item{
  display:flex;align-items:center;
  padding:30rpx 28rpx;
  border-bottom:2rpx solid #f1f5f9;
}
.form-item.last{ border-bottom:none; }
.form-item .label{
  width:180rpx; flex-shrink:0;
  font-size:28rpx; color:#475569; font-weight:500;
}
.form-item .inp{
  flex:1; font-size:28rpx; color:#0f172a;
  padding:14rpx 16rpx;
  background:#f8fafc;
  border:2rpx solid #e2e8f0;
  border-radius:12rpx;
}
.picker-inp{
  display:flex; align-items:center; justify-content:space-between;
}
.picker-inp.ph{ color:#94a3b8; }
.picker-arrow{ font-size:22rpx; color:#94a3b8; }

.def-card{
  margin-top:22rpx;
  background:#fff; border-radius:20rpx;
  padding:28rpx;
  display:flex; align-items:center; gap:20rpx;
  box-shadow:0 4rpx 18rpx rgba(100,116,139,0.06);
}
.rbox{
  width:40rpx; height:40rpx; border-radius:50%;
  border:3rpx solid #cbd5e1; background:#fff; flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
}
.rbox.on{
  border-color:#6366f1;
  background:radial-gradient(circle, #6366f1 46%, transparent 50%);
}
.def-info{ flex:1; }
.def-title{ font-size:28rpx; font-weight:600; color:#0f172a; margin-bottom:6rpx; }
.def-desc{ font-size:24rpx; color:#64748b; }
.toggle{
  width:88rpx; height:48rpx; border-radius:30rpx;
  background:#e2e8f0; position:relative; transition:0.2s;
  flex-shrink:0;
}
.toggle.on{ background:#6366f1; }
.toggle .dot{
  position:absolute; top:4rpx; left:4rpx;
  width:40rpx; height:40rpx; border-radius:50%;
  background:#fff; box-shadow:0 2rpx 6rpx rgba(15,23,42,0.15);
  transition:0.2s;
}
.toggle.on .dot{ left:44rpx; }

.btn-wrap{
  position:fixed; left:0; right:0; bottom:0;
  padding:24rpx 32rpx 48rpx;
  background:linear-gradient(180deg, rgba(245,247,250,0) 0%, #f5f7fa 40%);
}
.save-btn{
  width:100%; height:92rpx; line-height:92rpx;
  border-radius:50rpx; font-size:30rpx; font-weight:600;
  box-shadow: 0 16rpx 30rpx rgba(99,102,241,0.28);
}
