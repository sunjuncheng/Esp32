.page{padding:40rpx 30rpx;}
.bind-card{background:#fff;border-radius:24rpx;padding:50rpx 40rpx;box-shadow:0 8rpx 30rpx rgba(0,0,0,0.06);}
.icon{font-size:90rpx;text-align:center;margin-bottom:20rpx;}
.title{font-size:38rpx;font-weight:700;text-align:center;color:#0f172a;margin-bottom:16rpx;}
.desc{font-size:26rpx;color:#64748b;text-align:center;line-height:1.6;margin-bottom:40rpx;}
.input-row{display:flex;align-items:center;gap:16rpx;margin-bottom:30rpx;}
.inp{flex:1;background:#f1f5f9;border-radius:14rpx;padding:24rpx 28rpx;font-size:28rpx;font-family:monospace;}
.scan-btn{width:88rpx;height:88rpx;background:#f1f5f9;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;}
.tips{background:#f8fafc;border-radius:14rpx;padding:24rpx 28rpx;margin-bottom:36rpx;}
.tip-title{font-size:26rpx;font-weight:600;color:#475569;margin-bottom:14rpx;}
.tip-item{font-size:24rpx;color:#64748b;line-height:1.8;}
.btn-submit{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:40rpx;font-size:30rpx;font-weight:600;padding:24rpx;border:none;}
.btn-submit[disabled]{opacity:0.6;}
