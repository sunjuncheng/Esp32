<!-- 设备列表 -->
<view class="page">
  <view class="header-tip">
    <text>已绑定 {{devices.length}} 台设备</text>
    <view class="btn-bind" bindtap="goBind">➕ 绑定新设备</view>
  </view>

  <view wx:if="{{devices.length===0 && !loading}}" class="empty">
    <view class="empty-ic">🌡️</view>
    <view class="empty-txt">还没有绑定设备</view>
    <view class="empty-sub">点击右上角「绑定新设备」输入设备令牌</view>
  </view>

  <view class="device-list">
    <view class="dev-card" wx:for="{{devices}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="dev-head">
        <view class="dev-name">{{item.name}}</view>
        <view class="dev-status">
          <view class="dot {{item.online?'on':'off'}}"></view>
          <text>{{item.online?'在线':'离线'}}</text>
        </view>
      </view>
      <view class="dev-no">编号：{{item.no}}</view>
      <view class="dev-data">
        <view class="data-item">
          <view class="data-ic" style="background:#fee2e2;color:#ef4444;">🌡️</view>
          <view class="data-val">{{item.temp===null?'--':item.temp+'℃'}}</view>
          <view class="data-lbl">温度</view>
        </view>
        <view class="data-item">
          <view class="data-ic" style="background:#dbeafe;color:#3b82f6;">💧</view>
          <view class="data-val">{{item.humidity===null?'--':item.humidity+'%'}}</view>
          <view class="data-lbl">湿度</view>
        </view>
        <view class="data-item">
          <view class="data-ic" style="background:#fef3c7;color:#d97706;">🔔</view>
          <view class="data-val">{{item.alarmToday}}</view>
          <view class="data-lbl">今日报警</view>
        </view>
      </view>
      <view class="dev-foot">
        <text class="last-time">最后上报：{{item.lastTime}}</text>
        <view class="btn-unbind" catchtap="unbind" data-id="{{item.id}}" data-name="{{item.name}}">解绑</view>
      </view>
    </view>
  </view>
</view>
