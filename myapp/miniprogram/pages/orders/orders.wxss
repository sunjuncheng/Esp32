.empty-box{ min-height:100vh; }

.tabs-bar{
  display:flex;
  background:#fff;
  box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);
  position:sticky; top:0; z-index:10;
}
.tabs-bar .tab{
  flex:1;
  padding:28rpx 0;
  text-align:center;
  font-size:27rpx;
  color:#64748b;
  font-weight:600;
  position:relative;
  transition:all .2s;
}
.tabs-bar .tab.on{
  color:#667eea;
  font-weight:800;
}
.tabs-bar .tab.on::after{
  content:""; position:absolute; bottom:0; left:50%; transform:translateX(-50%);
  width:50rpx; height:6rpx; border-radius:6rpx;
  background:linear-gradient(135deg,#667eea,#764ba2);
}
.tabs-bar .t-n{
  display:inline-block; min-width:30rpx;height:30rpx; padding:0 8rpx;
  line-height:30rpx;
  margin-left:6rpx;background:#fee2e2;color:#dc2626;
  font-size:18rpx;border-radius:30rpx;font-weight:700;
}
.tab.on .t-n{ background:#ef4444;color:#fff; }

.order-card{ padding: 24rpx 24rpx 20rpx; }
.oc-top{
  display:flex;align-items:center;justify-content:space-between;
  padding-bottom:16rpx;border-bottom:1rpx dashed #f1f5f9;margin-bottom:18rpx;
}
.oc-id{
  font-size:24rpx;font-weight:800;color:#64748b;letter-spacing:0.5rpx;
}
.oc-sts{ display:flex;align-items:center; }

.goods-row{
  display:flex;gap:18rpx;align-items:center;
  padding:4rpx 0 18rpx;
}
.g-img{
  width:110rpx;height:110rpx;border-radius:14rpx;
  background:linear-gradient(135deg,#dbeafe,#ede9fe);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;flex-shrink:0;
}
.g-img image{ width:100%;height:100%; }
.g-info{ flex:1; min-width:0; display:flex;flex-direction:column;gap:4rpx; }
.g-name{
  font-size:28rpx;font-weight:700;color:#0f172a;line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.g-meta{ font-size:22rpx;color:#64748b; }
.g-time{ font-size:20rpx;color:#94a3b8;margin-top:4rpx; }
.g-right{ min-width:140rpx; text-align:right; }

.ship-card{
  background:linear-gradient(135deg,#eff6ff,#ede9fe);
  border-left:6rpx solid #667eea;
  border-radius:12rpx;padding:16rpx 20rpx;
  margin-bottom:18rpx;
}
.ship-line{
  font-size:24rpx;color:#1e3a8a;line-height:1.85;
  display:flex;flex-wrap:wrap;align-items:center;gap:4rpx;
}
.copy-btn{
  display:inline-flex;align-items:center;gap:4rpx;
  padding:4rpx 14rpx;background:#fff;border:1rpx solid #c7d2fe;
  color:#4f46e5;border-radius:8rpx;font-size:22rpx;font-weight:700;
  margin-left:8rpx;
}
.oc-actions{
  display:flex;justify-content:flex-end;gap:16rpx;
  padding-top:14rpx;border-top:1rpx dashed #f1f5f9;
}
.btn.btn-sm{ padding:12rpx 26rpx; font-size:24rpx; border-radius:10rpx; }
.btn-danger{
  background:#fee2e2; color:#b91c1c; border:2rpx solid #fecaca;
}
.btn-danger::after{ border:none; }
.tag-red{
  background:#fee2e2 !important; color:#b91c1c !important;
  border:2rpx solid #fecaca !important;
}
