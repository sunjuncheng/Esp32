.hero{
  background: linear-gradient(135deg,#667eea 0%, #764ba2 55%, #8b5cf6 100%);
  padding: 30rpx 32rpx 100rpx;
  color:#fff;
}
.hero-top{
  display:flex;
  align-items:center;
  margin-bottom:30rpx;
}
.hero h1{ font-size:40rpx; font-weight:800; margin:0 0 6rpx 0; }
.hero p { font-size:24rpx; opacity:.85; margin:0;}

.avatar-box{
  width:90rpx;height:90rpx;border-radius:50%;
  background:rgba(255,255,255,.2);
  display:flex;align-items:center;justify-content:center;
  backdrop-filter: blur(10rpx);
  overflow:hidden;
}
.avatar{
  width:100%;height:100%;
  background:linear-gradient(135deg,#fbbf24,#f59e0b);
  color:#78350f;font-weight:800;font-size:34rpx;
  display:flex;align-items:center;justify-content:center;
}
.login-btn{
  color:#fff;font-weight:700;font-size:26rpx;
  padding:12rpx 24rpx;
  border:2rpx solid rgba(255,255,255,.5);
  border-radius:40rpx;
}

.search-box{
  display:flex;align-items:center;gap:10rpx;
  background:#fff;border-radius:50rpx;
  padding:10rpx 14rpx 10rpx 24rpx;
  box-shadow:0 6rpx 20rpx rgba(102,126,234,0.3);
}
.s-ic{ font-size:28rpx; opacity:.5; margin-right:8rpx; }
.search-box input{
  flex:1;padding:16rpx 10rpx;font-size:28rpx;color:#334155;
}
.s-btn{
  background:linear-gradient(135deg,#667eea,#8b5cf6);
  color:#fff;padding:14rpx 28rpx;border-radius:40rpx;
  font-size:24rpx;font-weight:700;
}

.notice{
  background:linear-gradient(135deg,#fffbeb,#fef3c7);
  border-left:6rpx solid #f59e0b;
  border-radius:14rpx;
  padding:16rpx 20rpx;
  font-size:24rpx;color:#92400e;
  display:flex;align-items:center;gap:12rpx;
  margin-bottom:28rpx;
}
.notice-txt{ line-height:1.5; }

.cat-bar{ white-space:nowrap; margin-bottom:24rpx; }
.cat-wrap{ display:inline-flex; gap:16rpx; padding-right:20rpx; }
.cat{
  display:inline-flex;align-items:center;gap:8rpx;
  padding:14rpx 24rpx;border-radius:40rpx;
  background:#fff; border:2rpx solid #e2e8f0;
  font-size:25rpx;color:#475569;font-weight:600;
}
.cat.on{
  background:linear-gradient(135deg,#667eea,#764ba2);
  color:#fff; border-color:transparent;
  box-shadow:0 4rpx 12rpx rgba(102,126,234,.3);
}
.cat-c{ opacity:.7; }

.goods-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:20rpx;
}
.goods-item{
  background:#fff;border-radius:20rpx;
  overflow:hidden;
  box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);
  transition:transform .15s;
}
.goods-item:active{ transform:scale(0.98); }

.goods-img{
  position:relative;
  width:100%;
  aspect-ratio: 1 / 1;
  background:linear-gradient(135deg,#f1f5f9,#ede9fe);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
}
.goods-img image{ width:100%; height:100%; }
.hot{
  position:absolute;top:16rpx;left:16rpx;
  background:linear-gradient(135deg,#ef4444,#f97316);
  color:#fff;font-size:20rpx;font-weight:800;
  padding:6rpx 14rpx;border-radius:20rpx;
}

.goods-info{ padding:18rpx 20rpx 22rpx; }
.g-name{
  font-size:28rpx;font-weight:700;color:#0f172a;
  line-height:1.35;
  min-height:78rpx;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.g-desc{
  font-size:22rpx;color:#94a3b8;margin-top:8rpx;min-height:32rpx;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.g-bottom{
  display:flex;align-items:flex-end;justify-content:space-between;
  margin-top:14rpx;
}
.origin-price{
  color:#94a3b8;text-decoration:line-through;font-size:20rpx;margin-left:8rpx;
  font-weight:500;
}
.g-stock{
  font-size:20rpx;color:#64748b;
}
.g-stock.low{ color:#ef4444; font-weight:600; }
