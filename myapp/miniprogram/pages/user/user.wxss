.user-row{
  display:flex;align-items:center;gap:24rpx;
  padding:10rpx 0 40rpx;
}
.avt{
  width:110rpx;height:110rpx;border-radius:50%;
  background:linear-gradient(135deg,#fbbf24,#f59e0b);
  color:#78350f;font-weight:800;font-size:48rpx;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 6rpx 20rpx rgba(251,191,36,0.3);
}
.empty-avt{
  background:rgba(255,255,255,0.2);color:#fff;
  box-shadow:none;
}
.u-info{ flex:1; min-width:0; }
.u-name{ color:#fff;font-size:34rpx;font-weight:800;margin-bottom:6rpx;display:flex;align-items:center;gap:12rpx; }
.u-name .uid{
  font-size:22rpx;font-weight:500;color:rgba(255,255,255,0.75);
  padding:4rpx 14rpx;background:rgba(255,255,255,0.15);border-radius:20rpx;
}
.u-phone{ color:rgba(255,255,255,0.85);font-size:25rpx; }
.u-phone .tip{ font-size:20rpx;opacity:.85; }

.u-logout{
  padding:14rpx 26rpx;background:rgba(255,255,255,0.2);
  border:2rpx solid rgba(255,255,255,0.35);
  color:#fff;border-radius:40rpx;font-size:24rpx;font-weight:700;
}

.balance-card{
  background:linear-gradient(135deg,#fff 0%,#f8fafc 100%);
  border-radius:22rpx;
  padding:30rpx;
  display:flex;align-items:center;justify-content:space-between;gap:20rpx;
  box-shadow:0 10rpx 30rpx rgba(0,0,0,0.08);
  margin-top:20rpx;
}
.bc-lbl{ font-size:24rpx;color:#64748b;margin-bottom:8rpx; }
.bc-num{
  font-size:56rpx;font-weight:800;
  background:linear-gradient(135deg,#ef4444,#f97316);
  -webkit-background-clip:text;color:transparent;
  letter-spacing:-1rpx;
}
.bc-tip{ font-size:20rpx;color:#94a3b8;margin-top:6rpx; }

.stat-grid{
  display:grid; grid-template-columns:repeat(4,1fr);
  padding:10rpx 0;
}
.stat{
  display:flex;flex-direction:column;align-items:center;gap:8rpx;
  padding:16rpx 0;border-radius:14rpx;transition:all .15s;
}
.stat:active{ background:#f1f5f9; }
.stat .num{
  font-size:40rpx;font-weight:800;color:#667eea;line-height:1;
  font-family:'DIN Alternate',sans-serif;
}
.stat .txt{ font-size:22rpx;color:#64748b;font-weight:600; }

.card-title{ position:relative; }
.more{
  position:absolute; right:0; top:2rpx;
  font-size:22rpx;color:#667eea;font-weight:600;
}

.menu-item{
  display:flex;align-items:center;gap:20rpx;
  padding:22rpx 4rpx;border-bottom:1rpx dashed #f1f5f9;
  transition:all .15s;
}
.menu-item:last-child{ border-bottom:none; }
.menu-item:active{ background:#f8fafc; }
.m-ic{
  width:64rpx;height:64rpx;border-radius:14rpx;
  background:#f1f5f9;font-size:32rpx;
  display:flex;align-items:center;justify-content:center;
}
.m-txt{ flex:1;color:#334155;font-size:27rpx;font-weight:500; }
.m-arr{ color:#cbd5e1;font-size:30rpx;padding:0 10rpx; }
