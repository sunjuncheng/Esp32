.login-wrap{
  min-height:100vh;
  background:
    radial-gradient(ellipse at 20% -10%, rgba(102,126,234,0.22), transparent 60%),
    radial-gradient(ellipse at 100% 10%, rgba(139,92,246,0.18), transparent 60%),
    #f5f7fa;
  padding: 0 40rpx 80rpx;
}
.login-hero{
  padding: 80rpx 0 40rpx;
  text-align:center;
}
.login-hero .logo{
  font-size: 56rpx;
  font-weight:900;
  background:linear-gradient(135deg,#667eea,#764ba2);
  -webkit-background-clip:text;
  color:transparent;
  display:inline-flex;
  align-items:center;
  gap:16rpx;
  margin-bottom:16rpx;
}
.login-hero .sub{ font-size:25rpx;color:#64748b; }

.login-card{
  background:#fff;
  border-radius:28rpx;
  padding:40rpx 36rpx;
  box-shadow: 0 10rpx 50rpx rgba(102,126,234,0.08);
}
.tabs{
  display:flex;
  background:#f1f5f9;
  border-radius:14rpx;
  padding:8rpx;
  margin-bottom:40rpx;
}
.tabs .tab{
  flex:1;
  text-align:center;
  padding:18rpx 0;
  border-radius:10rpx;
  color:#64748b;
  font-weight:600;
  font-size:28rpx;
  transition:all .2s;
}
.tabs .tab.on{
  background:#fff;
  color:#667eea;
  box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05);
  font-weight:800;
}
.field{
  position:relative;
  display:flex;
  align-items:center;
  background:#f8fafc;
  border:2rpx solid #e2e8f0;
  border-radius:14rpx;
  padding:4rpx 10rpx 4rpx 16rpx;
  margin-bottom:24rpx;
  transition:all .2s;
}
.field:focus-within{
  border-color:#667eea;
  background:#fff;
  box-shadow:0 0 0 6rpx rgba(102,126,234,0.1);
}
.field .ic{ width:50rpx; font-size:30rpx; opacity:.8; }
.field input{ flex:1; padding:20rpx 10rpx; font-size:28rpx; }
.field .eye{
  padding:10rpx 20rpx; font-size:30rpx; opacity:.6;
}
.tips{
  font-size:22rpx;
  padding:0 8rpx;
  margin: -10rpx 0 30rpx;
  line-height:1.7;
}
.btn.big{
  padding:26rpx 0;
  font-size:30rpx;
  border-radius:16rpx;
  margin-top:20rpx;
}
.footer{
  text-align:center;
  padding:60rpx 0 20rpx;
  font-size:22rpx;
  opacity:.7;
}
