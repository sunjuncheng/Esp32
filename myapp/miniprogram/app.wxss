/* app.wxss 全局样式 */
page {
  background: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.55;
}

.container { padding: 24rpx; }

/* ===== 色板 ===== */
.c-primary { color: #667eea; }
.c-green   { color: #10b981; }
.c-red     { color: #ef4444; }
.c-orange  { color: #f59e0b; }
.c-gray    { color: #94a3b8; }
.c-3       { color: #0f172a; }
.c-6       { color: #475569; }

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 8rpx;
}
.tag-green  { background: #dcfce7; color: #166534; }
.tag-blue   { background: #dbeafe; color: #1d4ed8; }
.tag-purple { background: #ede9fe; color: #6d28d9; }
.tag-orange { background: #ffedd5; color: #c2410c; }
.tag-gray   { background: #f1f5f9; color: #64748b; }
.tag-red    { background: #fee2e2; color: #b91c1c; }

/* ===== 按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 40rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all .2s;
  line-height: 1;
}
.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}
.btn-green {
  background: linear-gradient(135deg, #11998e, #38ef7d);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(17, 153, 142, 0.25);
}
.btn-outline {
  background: #fff;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}
.btn-block { display: flex; width: 100%; }
.btn[disabled] { opacity: 0.5; }

/* ===== 空状态 ===== */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #94a3b8;
}
.empty-emoji {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}
.empty-txt { font-size: 26rpx; margin-bottom: 30rpx; }

/* ===== 分割线 ===== */
.hr { height: 1rpx; background: #f1f5f9; margin: 20rpx 0; }

/* ===== 价格 ===== */
.price {
  color: #ef4444;
  font-weight: 800;
  font-family: "DIN Alternate", sans-serif;
  letter-spacing: -0.5rpx;
}
.price-sm { font-size: 24rpx; }
.price-md { font-size: 30rpx; }
.price-lg { font-size: 40rpx; }
.price-xl { font-size: 56rpx; }

/* ===== flex 工具类 ===== */
.flex     { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.aic      { align-items: center; }
.jcb      { justify-content: space-between; }
.jcc      { justify-content: center; }
.flex1    { flex: 1; min-width: 0; }
.gap-sm   { gap: 12rpx; }
.gap-md   { gap: 20rpx; }
.gap-lg   { gap: 32rpx; }

/* ===== 渐变顶块 ===== */
.hero {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 55%, #8b5cf6 100%);
  padding: 40rpx 32rpx 80rpx;
  color: #fff;
  position: relative;
}
.hero h1 { font-size: 38rpx; font-weight: 800; margin-bottom: 8rpx; }
.hero p  { font-size: 24rpx; opacity: 0.85; }

/* 底部安全区（适配全面屏） */
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 30rpx); }
